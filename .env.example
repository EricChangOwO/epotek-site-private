# Shared mail settings
CONTACT_TO=sales@epotek.com.tw
MAIL_FROM=Epotek Website <website@your-verified-domain.com>

# Cloudflare Turnstile (use real production keys from the Cloudflare dashboard)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_ALLOWED_HOSTNAMES=epotek-site-private.vercel.app
# TURNSTILE_TESTING=true # local/CI only; never enable in production

# Recommended for Vercel/serverless (HTTPS API, no persistent SMTP socket)
RESEND_API_KEY=re_xxxxxxxxx

# SMTP fallback (used when RESEND_API_KEY is not set)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-user
# SMTP_PASS=your-password
